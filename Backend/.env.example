# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# Redis (Upstash or local). Used for ciphertext storage with TTL self-destruct.
REDIS_URL=redis://localhost:6379

# Supabase — used for auth verification, contact submissions, and secret metadata
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Resend — automated email
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=VaultShare <onboarding@resend.dev>
# Where contact-form notifications are sent
CONTACT_INBOX=you@example.com
